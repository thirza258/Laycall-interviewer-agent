# =============================================================================
# Interviewer App — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=production
DEBUG=False

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_USER=interview_user
DB_PASSWORD=interview_password
DB_NAME=interview_db
DB_PORT=5432
# Optional: a complete SQLAlchemy URL. When set it replaces the DB_* values
# above — useful for a managed database.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/interview_db

# ---------------------------------------------------------------------------
# OpenRouter (LLM API)
# ---------------------------------------------------------------------------
# REQUIRED — Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model identifier on OpenRouter. Every agent uses this model.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# Reliability tuning. Question generation makes several LLM calls in a row and
# a single call can take a minute, so the read timeout must stay generous —
# a short one shows up in the UI as the app "losing" the model.
OPENROUTER_TIMEOUT=90
OPENROUTER_CONNECT_TIMEOUT=10
OPENROUTER_MAX_RETRIES=3
# Ceiling for the whole question generation pipeline. Keep it below the
# proxy read timeout in frontend/nginx.conf (300s).
QUESTION_GENERATION_TIMEOUT=240

# ---------------------------------------------------------------------------
# MinIO / S3-compatible Storage
# ---------------------------------------------------------------------------
# docker-compose.yml reuses the MinIO already deployed by the decalove
# project (container decalove-minio, network decalove_default) instead of
# starting a second server. Set these to that server's credentials.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=interview
# Compose network the decalove services live on.
DECALOVE_NETWORK=decalove_default
# decalove publishes MinIO's S3 API on host port 4530. Used to build the
# browser-facing URL stored for resumes; inside compose the backend talks to
# decalove-minio:9000 directly.
MINIO_PUBLIC_URL=http://localhost:4530

# Used only by docker-compose.full.yml, which runs its own MinIO.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Only needed when running the backend outside docker compose, which passes
# these in itself. Without them the app still starts; resume uploads fail with
# "Object storage is not configured".
# MINIO_ENDPOINT=localhost:4530
# MINIO_SECURE=False

# ---------------------------------------------------------------------------
# Ports (host machine)
# ---------------------------------------------------------------------------
# Change these if the defaults conflict with services on your machine.
BACKEND_PORT=8000
FRONTEND_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
