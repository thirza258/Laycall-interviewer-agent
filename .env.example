# =============================================================================
# Interviewer App — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=production
DEBUG=False

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_USER=interview_user
DB_PASSWORD=interview_password
DB_NAME=interview_db
DB_PORT=5432

# ---------------------------------------------------------------------------
# OpenRouter (LLM API)
# ---------------------------------------------------------------------------
# REQUIRED — Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model identifier on OpenRouter. Every agent uses this model.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# Reliability tuning. Question generation makes several LLM calls in a row and
# a single call can take a minute, so the read timeout must stay generous —
# a short one shows up in the UI as the app "losing" the model.
OPENROUTER_TIMEOUT=90
OPENROUTER_CONNECT_TIMEOUT=10
OPENROUTER_MAX_RETRIES=3
# Ceiling for the whole question generation pipeline. Keep it below the
# proxy read timeout in frontend/nginx.conf (300s).
QUESTION_GENERATION_TIMEOUT=240

# ---------------------------------------------------------------------------
# MinIO / S3-compatible Storage
# ---------------------------------------------------------------------------
# These are used to bootstrap the local MinIO container.
# When using an external S3 provider, set these to your external credentials
# and remove the "minio" and "minio-init" services from docker-compose.yml.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=interview

# ---------------------------------------------------------------------------
# Ports (host machine)
# ---------------------------------------------------------------------------
# Change these if the defaults conflict with services on your machine.
BACKEND_PORT=8000
FRONTEND_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
